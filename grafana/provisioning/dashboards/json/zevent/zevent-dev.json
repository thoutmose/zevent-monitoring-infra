        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes{instance=\"srv-dev\"} / node_memory_MemTotal_bytes{instance=\"srv-dev\"})) * 100",
          "legendFormat": "RAM %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
