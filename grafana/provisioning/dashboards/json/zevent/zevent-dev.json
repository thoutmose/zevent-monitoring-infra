          "expr": "sum(rate(pg_stat_database_blks_hit{instance=\"srv-db\",datname=\"zevent-dev\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{instance=\"srv-db\",datname=\"zevent-dev\"}[5m])) + sum(rate(pg_stat_database_blks_read{instance=\"srv-db\",datname=\"zevent-dev\"}[5m]))) * 100",
          "legendFormat": "cache hit %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
