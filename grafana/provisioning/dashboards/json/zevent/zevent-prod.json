    {
      "id": 28,
      "type": "stat",
      "title": "zevent active connections",
      "description": "No PgBouncer exporter is deployed, so the pool ceiling (~50 real connections) is marked here as a static threshold rather than a live pool metric — 100 is the hard pg_max_connections ceiling (see the panel to the left).",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 72
      },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{instance=\"srv-db\",datname=\"zevent\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
