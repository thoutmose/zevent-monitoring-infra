        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes{instance=\"srv-prod\"} / node_memory_MemTotal_bytes{instance=\"srv-prod\"})) * 100",
