            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "Buffers written by source (srv-db instance)",
      "description": "Rising 'backend (forced write)' share is the classic tell that checkpointer/bgwriter can't keep up — backends are flushing their own dirty pages under IO contention.",
