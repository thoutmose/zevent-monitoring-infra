      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 108
      },
      "targets": [
        {
          "expr": "(increase(pg_stat_bgwriter_checkpoint_write_time_total{instance=\"srv-db\"}[5m]) + increase(pg_stat_bgwriter_checkpoint_sync_time_total{instance=\"srv-db\"}[5m])) / 1000 / 300 * 100",
