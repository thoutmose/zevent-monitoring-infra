      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 92
      },
      "targets": [
        {
          "expr": "pg_stat_activity_count{instance=\"srv-db\",datname=\"zevent\"}",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "zevent backends by wait_event_type",
      "description": "Live pg_stat_activity wait state. A sustained rise in 'IO' is IO contention; a rise in 'Lock' is blocking, not IO.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 92
      },
      "targets": [
        {
          "expr": "pg_wait_events_backends{instance=\"srv-db\",datname=\"zevent\"}",
          "legendFormat": "{{wait_event_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "zevent IO wait detail",
      "description": "Which specific IO wait (DataFileRead/Write, WALWrite/Sync, ...) backends are stuck on right now.",
