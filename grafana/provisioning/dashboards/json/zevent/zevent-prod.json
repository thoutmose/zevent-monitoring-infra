      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 100
      },
      "targets": [
        {
          "expr": "pg_io_wait_events_backends{instance=\"srv-db\",datname=\"zevent\"}",
          "legendFormat": "{{wait_event}}",
          "refId": "A"
        }
