          "legendFormat": "rollback",
          "refId": "B"
        }
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "zevent cache hit ratio",
      "description": "Cumulative buffer cache hit ratio (pg_stat_database, since last stats reset) — the standard DBA metric. Moves slowly by design. Alert fires below 80% sustained for 15m. For a fast-reacting real-time signal, see 'bgwriter pressure: backend writes vs clean' below.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 76
      },
      "targets": [
        {
          "expr": "sum(pg_stat_database_blks_hit{instance=\"srv-db\",datname=\"zevent\"}) / (sum(pg_stat_database_blks_hit{instance=\"srv-db\",datname=\"zevent\"}) + sum(pg_stat_database_blks_read{instance=\"srv-db\",datname=\"zevent\"})) * 100",
          "legendFormat": "cache hit % (cumulative, pg_stat_database)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "zevent deadlocks",
