        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_SwapFree_bytes{instance=\"srv-prod\"} / node_memory_SwapTotal_bytes{instance=\"srv-prod\"})) * 100",
