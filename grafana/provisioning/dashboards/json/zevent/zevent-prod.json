      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 116
      },
      "targets": [
        {
          "expr": "rate(pg_stat_bgwriter_buffers_checkpoint_total{instance=\"srv-db\"}[5m])",
