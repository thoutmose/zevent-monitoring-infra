          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_bgwriter_buffers_clean_total{instance=\"srv-db\"}[5m])",
          "legendFormat": "bgwriter (clean)",
          "refId": "B"
        },
        {
          "expr": "rate(pg_stat_bgwriter_buffers_backend_total{instance=\"srv-db\"}[5m])",
          "legendFormat": "backend (forced write)",
          "refId": "C"
        }
      ]
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "bgwriter maxwritten_clean stops (srv-db instance)",
      "description": "Rate of bgwriter hitting its per-round buffer cap and stopping early. Sustained >0 means bgwriter is falling behind the dirty-page rate.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 116
      },
      "targets": [
        {
          "expr": "rate(pg_stat_bgwriter_maxwritten_clean_total{instance=\"srv-db\"}[5m])",
          "legendFormat": "maxwritten_clean/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "bgwriter pressure: backend writes vs clean (srv-db instance)",
      "description": "The ratio that actually tracked the 2026-09-05 incident: ~21:1 before the fix, ~8.6:1 after. Alert fires above 15:1 sustained for 15m — a sign bgwriter_lru_maxpages is undersized for the current ingestion rate again.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 124
      },
      "targets": [
        {
          "expr": "rate(pg_stat_bgwriter_buffers_backend_total{instance=\"srv-db\"}[5m]) / (rate(pg_stat_bgwriter_buffers_clean_total{instance=\"srv-db\"}[5m]) + 1e-9)",
          "legendFormat": "backend:clean ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "zevent DB growth rate (srv-db instance)",
      "description": "Smoothed slope of on-disk database size. README estimates ~16.7GB/hour at full ingestion load — 173GB currently free on / (see Disk Usage by Mountpoint on srv-db).",
