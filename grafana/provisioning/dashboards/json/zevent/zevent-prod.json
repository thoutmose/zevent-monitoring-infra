    {
      "id": 38,
      "type": "timeseries",
      "title": "Checkpoints: timed vs requested (srv-db instance)",
      "description": "Shared PostgreSQL instance (zevent + zevent-dev). 'requested' (forced, out-of-schedule) sustained above 'timed' means WAL pressure is forcing checkpoints early — an ingestion-spike symptom.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 108
      },
      "targets": [
        {
          "expr": "rate(pg_stat_bgwriter_checkpoints_timed_total{instance=\"srv-db\"}[5m])",
          "legendFormat": "timed",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_bgwriter_checkpoints_req_total{instance=\"srv-db\"}[5m])",
          "legendFormat": "requested (forced)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 39,
      "type": "timeseries",
      "title": "Checkpoint I/O busy % of window (srv-db instance)",
      "description": "Share of each 5m window the checkpointer spent writing+syncing checkpoint data. Sustained >50% means a checkpoint that's dragging on.",
